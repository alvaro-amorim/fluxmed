# FluxMed local development
# Copy this file to `.env` at the repository root. Never commit the real `.env`.
POSTGRES_DB=fluxmed
POSTGRES_USER=fluxmed
POSTGRES_PASSWORD=fluxmed
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fluxmed:fluxmed@localhost:5432/fluxmed
TEST_DATABASE_URL=postgresql+psycopg://fluxmed:fluxmed@localhost:5432/fluxmed

# Authentication
SESSION_COOKIE_NAME=fluxmed_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false

# Public demo account. This password is intentionally demonstrative, never a production secret.
DEMO_PLANNER_EMAIL=planner@fluxmed.demo
DEMO_PLANNER_DISPLAY_NAME=Planejador Demo
DEMO_PLANNER_PASSWORD=FluxMedDemo2026!

# LLM assistant. Keep mock while developing/testing locally without external token spend.
LLM_PROVIDER=mock
LLM_MODEL=fluxmed-mock-v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOOL_CALLS=5
LLM_MAX_OUTPUT_CHARS=6000

# Real providers are backend-only. Uncomment exactly the provider/key you want to test locally.
# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=replace-me
# Cohere example:
# LLM_PROVIDER=cohere
# LLM_MODEL=command-a-plus-05-2026
# COHERE_API_KEY=replace-me

# Frontend: leave base URL blank in local Vite development to use the dev proxy.
# Only VITE_* variables are exposed to browser code.
VITE_API_BASE_URL=
VITE_DEMO_EMAIL=planner@fluxmed.demo
VITE_DEMO_PASSWORD=FluxMedDemo2026!
